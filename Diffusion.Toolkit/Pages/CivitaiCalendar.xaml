<pages:NavigationPage x:Class="Diffusion.Toolkit.Pages.CivitaiCalendar"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:local="clr-namespace:Diffusion.Toolkit.Models"
                xmlns:converters="clr-namespace:Diffusion.Toolkit.Converters"
                xmlns:pages="clr-namespace:Diffusion.Toolkit.Pages"
                mc:Ignorable="d"
                d:DataContext="{d:DesignInstance local:CivitaiCalendarModel, IsDesignTimeCreatable=False}"
                d:DesignHeight="700" d:DesignWidth="1200"
                Title="CivitAI Calendar">

    <pages:NavigationPage.Resources>
        <converters:BoolToVisibilityCollapsedConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityCollapsedConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:InvertBoolConverter x:Key="InverseBoolConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:LocalTimeConverter x:Key="LocalTimeConverter"/>
        <SolidColorBrush x:Key="ScheduledBrush" Color="#E0A800"/>
        <!-- Fixed colours rather than theme brushes: these have to stay legible
             against both the light and dark cell backgrounds, and the alpha
             channel does the blending. -->
        <!-- Today is blue, the cell being examined is green: two different hues,
             so "where am I" and "what is today" never have to be told apart by
             thickness alone. Both are heavier than the 1px default. -->
        <SolidColorBrush x:Key="TodayBrush" Color="#2E8BFF"/>
        <SolidColorBrush x:Key="TodayBackgroundBrush" Color="#382E8BFF"/>
        <SolidColorBrush x:Key="SelectedDayBrush" Color="#22C55E"/>
        <SolidColorBrush x:Key="SelectedDayBackgroundBrush" Color="#3322C55E"/>
        <SolidColorBrush x:Key="OutOfRangeBrush" Color="#26808080"/>
    </pages:NavigationPage.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
            <Label Content="CivitAI Calendar" FontSize="22" FontWeight="DemiBold" DockPanel.Dock="Left"
                   Foreground="{DynamicResource ForegroundBrush}"/>
            <Button Content="⬇ Download…" Command="{Binding DownloadCommand}" DockPanel.Dock="Right"
                    Padding="12,4" Margin="6,0,0,0"
                    ToolTip="Choose what to fetch from CivitAI: posts, engagement counters, or the image files missing from your library."
                    IsEnabled="{Binding IsRefreshing, Converter={StaticResource InverseBoolConverter}}"/>
            <TextBlock Text="{Binding LastUpdated}" DockPanel.Dock="Right" VerticalAlignment="Center"
                       ToolTip="Reaction, comment and tip counts are a snapshot from this fetch, not live."
                       Foreground="{DynamicResource ForegroundBrush}" Opacity="0.6" Margin="6,0"/>
        </DockPanel>

        <!-- Month navigation + panel toggles -->
        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="◀" Command="{Binding PrevMonthCommand}" IsEnabled="{Binding CanGoPrev}" Padding="10,2"/>
                <TextBlock Text="{Binding MonthLabel}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                           MinWidth="180" TextAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                <Button Content="▶" Command="{Binding NextMonthCommand}" IsEnabled="{Binding CanGoNext}" Padding="10,2"/>
                <Button Content="Today" Command="{Binding TodayCommand}" Padding="10,2" Margin="10,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <ToggleButton Content="Day view" IsChecked="{Binding ShowDayPanel}" Padding="10,2" Margin="4,0,0,0"
                              ToolTip="Show or hide the day detail panel"/>
                <ToggleButton Content="Preview" IsChecked="{Binding ShowPreviewPanel}" Padding="10,2" Margin="4,0,0,0"
                              ToolTip="Show or hide the image preview panel"/>
            </StackPanel>

            <!-- Legend: three cell states that are otherwise guessable only by colour. -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="3,0,10,0"/>
                        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                        <Setter Property="Opacity" Value="0.75"/>
                    </Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="11"/>
                        <Setter Property="Height" Value="11"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="CornerRadius" Value="2"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </StackPanel.Resources>
                <Border BorderBrush="{StaticResource TodayBrush}" Background="{StaticResource TodayBackgroundBrush}"/>
                <TextBlock Text="Today"/>
                <Border BorderBrush="{StaticResource SelectedDayBrush}" Background="{StaticResource SelectedDayBackgroundBrush}"/>
                <TextBlock Text="Viewing"/>
                <Border BorderBrush="{StaticResource ScheduledBrush}" Background="Transparent"/>
                <TextBlock Text="Queued"/>
            </StackPanel>
        </DockPanel>

        <!-- Status strips: live progress while fetching, hint when no data yet -->
        <StackPanel Grid.Row="2">
            <Border Margin="0,0,0,6" Padding="8,5" CornerRadius="3"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                    Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <Button Content="Cancel" Command="{Binding CancelFetchCommand}" DockPanel.Dock="Right"
                            Padding="10,2" Margin="8,0,0,0"/>
                    <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="120" Height="6"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" FontSize="12"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                </DockPanel>
            </Border>
            <Border Margin="0,0,0,6" Padding="8,5" CornerRadius="3"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1"
                    Visibility="{Binding HasCache, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <TextBlock FontSize="12" Foreground="{DynamicResource ForegroundBrush}" Opacity="0.8"
                           Text="No CivitAI posts loaded yet — press ⬇ Download… and pick how far back to fetch."/>
            </Border>
        </StackPanel>

        <!-- Body: calendar | splitter | (day view / splitter / preview) -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="RightColumn" Width="400" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- Calendar -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="7">
                    <UniformGrid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                        </Style>
                    </UniformGrid.Resources>
                    <TextBlock Text="Mon"/>
                    <TextBlock Text="Tue"/>
                    <TextBlock Text="Wed"/>
                    <TextBlock Text="Thu"/>
                    <TextBlock Text="Fri"/>
                    <TextBlock Text="Sat"/>
                    <TextBlock Text="Sun"/>
                </UniformGrid>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" Rows="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="1" CornerRadius="2"
                                    MouseLeftButtonUp="DayCell_Click" AllowDrop="True"
                                    Drop="DayCell_Drop" DragOver="DayCell_DragOver"
                                    Tag="{Binding}" ClipToBounds="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <!-- The plain-cell look is set HERE, not as local
                                             attributes on the Border. A local value beats
                                             every Style trigger in WPF's property
                                             precedence, so with BorderBrush/Background/
                                             BorderThickness written on the element the
                                             triggers below ran but changed nothing, and
                                             today and the viewed day looked like every
                                             other cell. -->
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                <Setter Property="Opacity" Value="0.35"/>
                                            </DataTrigger>
                                            <!-- Past the scheduling ceiling: greyed out and struck through
                                                 so it reads as unavailable rather than merely empty. -->
                                            <DataTrigger Binding="{Binding IsBeyondScheduleLimit}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource OutOfRangeBrush}"/>
                                                <Setter Property="Opacity" Value="0.45"/>
                                                <Setter Property="ToolTip" Value="{Binding ScheduleLimitTooltip}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasScheduled}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource ScheduledBrush}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                            <!-- After HasScheduled so today always keeps its own border. -->
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource TodayBrush}"/>
                                                <Setter Property="BorderThickness" Value="3"/>
                                                <Setter Property="Background" Value="{StaticResource TodayBackgroundBrush}"/>
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                            <!-- Last: the cell you are examining outranks everything else,
                                                 including today, and keeps a hue of its own. When it IS
                                                 today, the green border wins but the TODAY chip stays, so
                                                 the two never collapse into one ambiguous cell. -->
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource SelectedDayBrush}"/>
                                                <Setter Property="BorderThickness" Value="3"/>
                                                <Setter Property="Background" Value="{StaticResource SelectedDayBackgroundBrush}"/>
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Margin="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" LastChildFill="False">
                                        <TextBlock Text="{Binding DayNumber}" DockPanel.Dock="Left">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TodayBrush}"/>
                                                        </DataTrigger>
                                                        <!-- After today, matching the border's priority. -->
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="Foreground" Value="{StaticResource SelectedDayBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border DockPanel.Dock="Left" CornerRadius="3" Padding="4,1" Margin="5,2,0,0"
                                                VerticalAlignment="Top" Background="{StaticResource TodayBrush}"
                                                Visibility="{Binding IsToday, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="TODAY" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                        <!-- A filled dot rather than a second word: the cell header is
                                             narrow and a "VIEWING" chip next to "TODAY" would push the
                                             image count off the clipped edge. -->
                                        <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="5,5,0,0"
                                                 VerticalAlignment="Top" Fill="{StaticResource SelectedDayBrush}"
                                                 ToolTip="The day shown in the panel on the right"
                                                 Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="🔒" FontSize="9" Margin="0,0,2,0"
                                                   Foreground="{DynamicResource ForegroundBrush}" Opacity="0.7"
                                                   ToolTip="{Binding ScheduleLimitTooltip}"
                                                   Visibility="{Binding IsBeyondScheduleLimit, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <Border DockPanel.Dock="Right" CornerRadius="8" Padding="5,0"
                                                Background="{DynamicResource PrimaryBrush}"
                                                Visibility="{Binding HasImages, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding ImageCount}" Foreground="White" FontSize="10"/>
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" Text="⏱" FontSize="10" Margin="0,0,3,0"
                                                   Foreground="{StaticResource ScheduledBrush}" ToolTip="Has queued/scheduled posts"
                                                   Visibility="{Binding HasScheduled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </DockPanel>
                                    <Grid Grid.Row="1">
                                        <ItemsControl ItemsSource="{Binding CellImages}" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="40" Height="40" Margin="1" CornerRadius="2"
                                                            Background="{DynamicResource PreviewBackgroundBrush}"
                                                            ClipToBounds="True"
                                                            ToolTip="{Binding Name}">
                                                        <Grid>
                                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                            <TextBlock Text="?" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource ForegroundBrush}" Opacity="0.25"
                                                                       Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="8"
                                                Padding="5,1" Margin="0,0,1,1" Background="#A0000000"
                                                Visibility="{Binding HasOverflow, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding OverflowText}" Foreground="White" FontSize="10"
                                                       ToolTip="More images this day — click the cell to see them all in the day view"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource SplitterBrush}" x:Name="RightSplitter"/>

            <!-- Right side: day view over preview, both collapsible, resizable -->
            <Grid Grid.Column="2" x:Name="RightPanel">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="DayViewRow" Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="PreviewRow" Height="*"/>
                </Grid.RowDefinitions>

                <!-- Day view -->
                <Border Grid.Row="0" BorderThickness="1" CornerRadius="3" Margin="4,0,0,0"
                        BorderBrush="{DynamicResource NormalBorderBrush}"
                        Background="{DynamicResource ControlBackgroundBrush}"
                        Visibility="{Binding ShowDayPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel Margin="8">
                        <TextBlock DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Text="{Binding SelectedDay.Date, StringFormat='dddd, d MMMM yyyy', FallbackValue='Select a day'}"/>
                        <TextBlock DockPanel.Dock="Top" FontSize="11" Foreground="{DynamicResource ForegroundBrush}" Opacity="0.6"
                                   Text="Click a day in the calendar. Click an image below to preview it."
                                   Visibility="{Binding HasSelectedDay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding SelectedDay.Images}">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1" Padding="4,6" CornerRadius="2"
                                            BorderBrush="{DynamicResource NormalBorderBrush}"
                                            MouseLeftButtonUp="DayImage_Click" Tag="{Binding}">
                                      <Border.ContextMenu>
                                          <!-- ContextMenu sits outside the visual tree, so the row's
                                               DataContext has to be pulled in from the placement target. -->
                                          <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                              <MenuItem Header="Show in Search" Click="ShowInSearch_Click" Tag="{Binding}"/>
                                              <MenuItem Header="Open with the default viewer" Click="OpenLocal_Click" Tag="{Binding}"/>
                                              <MenuItem Header="Open on CivitAI" Click="OpenOnCivitai_Click" Tag="{Binding}"/>
                                          </ContextMenu>
                                      </Border.ContextMenu>
                                      <Border.Style>
                                          <Style TargetType="Border">
                                              <Setter Property="Background" Value="Transparent"/>
                                              <Style.Triggers>
                                                  <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                      <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
                                                  </DataTrigger>
                                              </Style.Triggers>
                                          </Style>
                                      </Border.Style>
                                      <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Left" Width="48" Height="48" Margin="0,0,8,0"
                                                CornerRadius="3" Background="{DynamicResource PreviewBackgroundBrush}">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                <TextBlock Text="?" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource ForegroundBrush}" Opacity="0.3"
                                                           Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ForegroundBrush}">
                                                    <Run Text="{Binding PublishedAtUtc, Converter={StaticResource LocalTimeConverter}, Mode=OneWay}"/>
                                                    <Run Text=" — Post "/>
                                                    <Run Text="{Binding PostId, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock DockPanel.Dock="Right" Text="⏱ Queued" FontSize="11"
                                                           Foreground="{StaticResource ScheduledBrush}"
                                                           Visibility="{Binding IsQueued, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="11"
                                                       Foreground="{DynamicResource ForegroundBrush}" Opacity="0.7"/>
                                            <!-- Compact engagement: totals only, this row is narrow.
                                                 The full breakdown lives in the preview panel below.
                                                 Comments and collections show a real 0 once the
                                                 per-image numbers are in, and stay hidden while all
                                                 we have is the post-wide block, which cannot tell a
                                                 zero apart from a counter it never reported. -->
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                        ToolTip="{Binding StatsTooltip}"
                                                        Visibility="{Binding HasStats, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock FontSize="11" Margin="0,0,8,0"
                                                           Foreground="{DynamicResource ForegroundBrush}" Opacity="0.75"
                                                           ToolTip="Reactions"
                                                           Visibility="{Binding HasReactions, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Run Text="♥"/><Run Text=" "/><Run Text="{Binding ReactionSummary, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="11" Margin="0,0,8,0"
                                                           Foreground="{DynamicResource ForegroundBrush}" Opacity="0.75"
                                                           ToolTip="Comments"
                                                           Visibility="{Binding ShowComments, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Run Text="💬"/><Run Text=" "/><Run Text="{Binding CommentSummary, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="11" Margin="0,0,8,0"
                                                           Foreground="{DynamicResource ForegroundBrush}" Opacity="0.75"
                                                           ToolTip="Times this image was collected"
                                                           Visibility="{Binding ShowCollected, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Run Text="🗂"/><Run Text=" "/><Run Text="{Binding CollectedSummary, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="no reactions yet" FontSize="10" FontStyle="Italic"
                                                           Foreground="{DynamicResource ForegroundBrush}" Opacity="0.4"
                                                           Visibility="{Binding HasNoEngagement, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Button Content="Open on CivitAI" Click="OpenOnCivitai_Click" Tag="{Binding}" Padding="6,2" Margin="0,0,4,0"/>
                                                <Button Content="Show in Search" Click="ShowInSearch_Click" Tag="{Binding}" Padding="6,2"
                                                        ToolTip="Show this image on its own in the Search page"
                                                        Visibility="{Binding LocalPath, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            </StackPanel>
                                            <TextBlock Text="⚠ multiple local matches — best candidate shown in preview" FontSize="10"
                                                       Foreground="{StaticResource ScheduledBrush}"
                                                       Visibility="{Binding IsAmbiguous, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock Text="✗ no local file matched — use ⬇ Download… or Open on CivitAI" FontSize="10"
                                                       Foreground="{DynamicResource ForegroundBrush}" Opacity="0.5"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding IsUnmatched, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding NamelessHint}"
                                                       FontSize="10" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ForegroundBrush}" Opacity="0.5"
                                                       Visibility="{Binding NeedsNamelessDownload, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                      </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="{DynamicResource SplitterBrush}" x:Name="PreviewSplitter"/>

                <!-- Image preview -->
                <Border Grid.Row="2" BorderThickness="1" CornerRadius="3" Margin="4,0,0,0"
                        BorderBrush="{DynamicResource NormalBorderBrush}"
                        Background="{DynamicResource PreviewBackgroundBrush}"
                        Visibility="{Binding ShowPreviewPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel Margin="8">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedImage.Name, FallbackValue='Preview'}"
                                   FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"
                                   Foreground="{DynamicResource ForegroundBrush}"/>

                        <!-- Full engagement breakdown. Each chip hides at zero so an
                             untouched post shows one honest line instead of a wall of
                             zeroes; counters the fetch never reported are absent, not 0. -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,4" Padding="6,3" CornerRadius="3"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                DataContext="{Binding SelectedImage}" ToolTip="{Binding StatsTooltip}"
                                Visibility="{Binding HasStats, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                            <WrapPanel>
                                <WrapPanel.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Margin" Value="0,0,10,0"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                        <Setter Property="Opacity" Value="0.85"/>
                                    </Style>
                                </WrapPanel.Resources>
                                <TextBlock Text="{Binding LikeText}" ToolTip="Likes"
                                           Visibility="{Binding HasLikes, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding HeartText}" ToolTip="Hearts"
                                           Visibility="{Binding HasHearts, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding LaughText}" ToolTip="Laughs"
                                           Visibility="{Binding HasLaughs, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding CryText}" ToolTip="Cries"
                                           Visibility="{Binding HasCries, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding DislikeText}" ToolTip="Dislikes"
                                           Visibility="{Binding HasDislikes, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <!-- After the five reactions: comments, collections, then the
                                     Buzz tipped on this image. All three show a real 0 once the
                                     per-image fetch has run, and are hidden entirely while only
                                     post-wide totals are known — those carry no Buzz at all, so
                                     a "⚡ 0" built from them would be a number we do not have. -->
                                <TextBlock Text="{Binding CommentText}" ToolTip="Comments"
                                           Visibility="{Binding ShowComments, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding CollectedText}" ToolTip="Times collected"
                                           Visibility="{Binding ShowCollected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding TippedText}" ToolTip="Buzz tipped on this image"
                                           Visibility="{Binding ShowTips, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding ViewText}" ToolTip="Views"
                                           Visibility="{Binding HasViews, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="No reactions, comments or tips yet." FontStyle="Italic" Opacity="0.5"
                                           Visibility="{Binding HasNoEngagement, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <!-- Says so on screen, not only in the tooltip: these are the
                                     post's totals shared by every image in it, and they carry
                                     no tip or view counts. -->
                                <TextBlock Text="(post totals)" FontStyle="Italic" Opacity="0.45"
                                           Visibility="{Binding StatsArePostWide, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </WrapPanel>
                        </Border>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0"
                                    Visibility="{Binding HasSelectedImage, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button Content="Open on CivitAI" Click="OpenSelectedOnCivitai_Click" Padding="8,3" Margin="0,0,4,0"/>
                            <Button Content="Show in Search" Click="ShowSelectedInSearch_Click" Padding="8,3" Margin="0,0,4,0"
                                    ToolTip="Show this image on its own in the Search page"
                                    Visibility="{Binding SelectedImageHasLocal, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Button Content="Open externally" Click="OpenSelectedLocal_Click" Padding="8,3" Margin="0,0,4,0"
                                    ToolTip="Open the file with the Windows default image viewer"
                                    Visibility="{Binding SelectedImageHasLocal, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="Drag the image onto a future day to reschedule it" FontSize="10"
                                       VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" Opacity="0.5"
                                       Visibility="{Binding SelectedImageHasLocal, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                        <Grid>
                            <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                                   PreviewMouseLeftButtonDown="PreviewImage_MouseDown"
                                   MouseMove="PreviewImage_MouseMove"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding PreviewImage, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}">
                                <TextBlock Text="No preview" FontSize="14" TextAlignment="Center"
                                           Foreground="{DynamicResource ForegroundBrush}" Opacity="0.5"/>
                                <TextBlock Text="Click an image in the day view. Unmatched images can only be opened on CivitAI."
                                           FontSize="10" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="240" Margin="0,4,0,0"
                                           Foreground="{DynamicResource ForegroundBrush}" Opacity="0.4"/>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</pages:NavigationPage>
