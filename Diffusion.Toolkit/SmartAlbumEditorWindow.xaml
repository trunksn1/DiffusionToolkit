<local:BorderlessWindow x:Class="Diffusion.Toolkit.SmartAlbumEditorWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:local="clr-namespace:Diffusion.Toolkit"
                  xmlns:models="clr-namespace:Diffusion.Toolkit.Models"
                  mc:Ignorable="d"
                  d:DataContext="{d:DesignInstance local:SmartAlbumEditorModel, IsDesignTimeCreatable = True}"
                  WindowStartupLocation="CenterOwner"
                  MenuWidth="0"
                  TitleWidth="*"
                  Style="{StaticResource BorderlessWindowStyle}"
                  Title="Smart Albums" Height="600" Width="750">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding Escape}"></KeyBinding>
    </Window.InputBindings>
    <Grid Margin="0,20,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Smart Album List -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label FontWeight="Bold" FontSize="14" Margin="5,0">Smart Albums</Label>
            <ListBox Grid.Row="1" ItemsSource="{Binding SmartAlbums}"
                     SelectedItem="{Binding SelectedSmartAlbum}"
                     SelectionChanged="SmartAlbumList_OnSelectionChanged"
                     Margin="5">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Delete" Click="DeleteSmartAlbum_OnClick"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5">
                <Button Click="NewSmartAlbum_OnClick" Padding="10,3">New</Button>
            </StackPanel>
        </Grid>

        <!-- Right: Editor -->
        <Grid Grid.Column="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Name -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5">
                <Label FontWeight="Bold">Name:</Label>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="300" VerticalContentAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                    <RadioButton IsChecked="{Binding MatchAll}" VerticalAlignment="Center" Margin="0,0,10,0">Match All</RadioButton>
                    <RadioButton VerticalAlignment="Center">Match Any</RadioButton>
                </StackPanel>
            </StackPanel>

            <!-- Rules header -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
                <Label FontWeight="Bold">Rules:</Label>
                <Button Click="AddRule_OnClick" Padding="10,2" Margin="10,0,0,0">Add Rule</Button>
                <Button Click="RemoveRule_OnClick" Padding="10,2" Margin="5,0,0,0">Remove Last Rule</Button>
            </StackPanel>

            <!-- Rules list -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <ComboBox ItemsSource="{x:Static models:SmartAlbumRuleHelper.AllFields}"
                                          SelectedItem="{Binding Field}"
                                          SelectionChanged="Field_OnSelectionChanged"
                                          Width="130" Margin="0,0,5,0"/>
                                <ComboBox ItemsSource="{Binding AvailableOperators}"
                                          SelectedItem="{Binding Operator}"
                                          Width="140" Margin="0,0,5,0"/>
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         Width="200"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10">
                <Button Click="Preview_OnClick" Padding="10,5">Preview</Button>
                <Label VerticalAlignment="Center" Margin="10,0">
                    <TextBlock>
                        <Run Text="{Binding PreviewCount, Mode=OneWay}"/>
                        <Run Text=" matching images"/>
                    </TextBlock>
                </Label>
                <Button Click="Save_OnClick" Padding="20,5" Margin="20,0,0,0">Save</Button>
            </StackPanel>

            <!-- Status -->
            <StatusBar Grid.Row="4">
                <StatusBarItem>
                    <TextBlock Text="{Binding Status}"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</local:BorderlessWindow>
