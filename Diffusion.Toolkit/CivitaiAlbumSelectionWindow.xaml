<local:BorderlessWindow x:Class="Diffusion.Toolkit.CivitaiAlbumSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Diffusion.Toolkit"
        mc:Ignorable="d"
        Title="Assign Images to Album" Height="350" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Choose an album for downloaded images"
                   FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource ForegroundBrush}"
                   Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" x:Name="ImageCountText"
                   Foreground="{DynamicResource ForegroundBrush}"
                   Margin="0,0,0,15"/>

        <GroupBox Grid.Row="2" Header="Select Album" Margin="0,0,0,10"
                  Foreground="{DynamicResource ForegroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <RadioButton x:Name="SkipRadioButton" Content="Skip (don't assign to any album)"
                                 GroupName="AlbumChoice"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 Margin="5" IsChecked="True"/>

                    <RadioButton x:Name="NewAlbumRadioButton" Content="Create new album:"
                                 GroupName="AlbumChoice"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 Margin="5,10,5,5"/>

                    <TextBox x:Name="NewAlbumTextBox" Margin="25,0,5,10"
                             GotFocus="NewAlbumTextBox_GotFocus"
                             Background="{DynamicResource SecondaryBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"/>

                    <TextBlock Text="Existing Albums:"
                               Foreground="{DynamicResource ForegroundBrush}"
                               Margin="5,10,5,5" FontWeight="Bold"/>

                    <ItemsControl x:Name="AlbumsListBox" Margin="5">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding Name}"
                                             GroupName="AlbumChoice"
                                             Tag="{Binding Name}"
                                             Foreground="{DynamicResource ForegroundBrush}"
                                             Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <CheckBox Grid.Row="3" x:Name="RememberCheckBox"
                  Content="Remember my choice and don't ask again"
                  Foreground="{DynamicResource ForegroundBrush}"
                  Margin="0,0,0,15"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Margin="0,0,10,0" Click="OkButton_Click"
                    Background="{DynamicResource SecondaryBrush}"
                    Foreground="{DynamicResource ForegroundBrush}"/>
            <Button Content="Cancel" Width="80" Click="CancelButton_Click"
                    Background="{DynamicResource SecondaryBrush}"
                    Foreground="{DynamicResource ForegroundBrush}"/>
        </StackPanel>
    </Grid>
</local:BorderlessWindow>
