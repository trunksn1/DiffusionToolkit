<Window x:Class="Diffusion.Toolkit.HistoryRangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recover Post History" Height="240" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Rebuild the full history of your CivitAI posts. This can take a while for a large range, so choose how far back to go."/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Fetch posts from" FontWeight="SemiBold"/>
            <DatePicker x:Name="FromPart" Width="160" HorizontalAlignment="Left" Margin="0,2,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Margin="0,8,0,0" FontSize="11"
                   Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                   Text="Earliest available: November 2022 (CivitAI's founding)."/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" Padding="14,4" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Recover" Click="Recover_Click" Padding="14,4" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
