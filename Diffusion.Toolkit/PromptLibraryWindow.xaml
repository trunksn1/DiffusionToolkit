<local:BorderlessWindow x:Class="Diffusion.Toolkit.PromptLibraryWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:local="clr-namespace:Diffusion.Toolkit"
                  mc:Ignorable="d"
                  d:DataContext="{d:DesignInstance local:PromptLibraryModel, IsDesignTimeCreatable = True}"
                  WindowStartupLocation="CenterOwner"
                  MenuWidth="0"
                  TitleWidth="*"
                  Style="{StaticResource BorderlessWindowStyle}"
                  Title="Prompt Library" Height="600" Width="800">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding Escape}"></KeyBinding>
    </Window.InputBindings>
    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search/Filter Bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,5">
            <Label VerticalAlignment="Center">Search:</Label>
            <TextBox x:Name="SearchBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Width="250" VerticalContentAlignment="Center" Padding="3,0"
                     KeyDown="SearchBox_OnKeyDown"/>
            <Label VerticalAlignment="Center" Margin="10,0,0,0">Category:</Label>
            <ComboBox x:Name="CategoryFilter" ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory}"
                      SelectionChanged="CategoryFilter_OnSelectionChanged"
                      Width="150" Margin="5,0"/>
            <Button Click="ClearFilter_OnClick" Padding="10,3" Margin="5,0">Clear</Button>
            <Button Click="NewTemplate_OnClick" Padding="10,3" Margin="10,0,0,0">New Template</Button>
        </StackPanel>

        <!-- Templates Grid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Templates}"
                  SelectedItem="{Binding SelectedTemplate}"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  IsReadOnly="True"
                  Margin="10,5"
                  MouseDoubleClick="Templates_OnDoubleClick">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy Prompt" Click="CopyPrompt_OnClick"/>
                    <MenuItem Header="Copy Prompt + Settings" Click="CopyPromptWithSettings_OnClick"/>
                    <Separator/>
                    <MenuItem Header="Edit" Click="EditTemplate_OnClick"/>
                    <MenuItem Header="Delete" Click="DeleteTemplate_OnClick"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                <DataGridTextColumn Header="Prompt" Binding="{Binding Prompt}" Width="300">
                    <DataGridTextColumn.ElementStyle>
                        <Style>
                            <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="TextBlock.MaxHeight" Value="40"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="100"/>
                <DataGridTextColumn Header="Uses" Binding="{Binding UseCount}" Width="50"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Preview -->
        <Grid Grid.Row="2" Margin="10,0,10,10" Height="80">
            <TextBox IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Text="{Binding SelectedTemplate.Prompt, Mode=OneWay}"
                     FontSize="11" Background="Transparent"/>
        </Grid>
    </Grid>
</local:BorderlessWindow>
